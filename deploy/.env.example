# Orion Core settings for deploy/docker-compose.yml.
#
# Quick start:   cp .env.example .env   then fill in the three REQUIRED values below
#                (or run deploy/scripts/setup-core.sh, which does this and generates secrets for you).
# Start Core:    docker compose --env-file .env up -d
# Everything not marked REQUIRED has a safe default and can stay commented out.
# Keep this file private (chmod 600 .env) and out of version control.

# ---------------------------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------------------------

# The Console login. Core refuses to start without a password (the username defaults to admin).
ORION_ADMIN_USERNAME=admin
# At least 12 characters.  Generate one:  openssl rand -base64 24 | tr -d '/+='
ORION_ADMIN_PASSWORD=
# Signs Console sessions. 32 characters or more.  Generate one:  openssl rand -hex 32
ORION_JWT_SECRET=

# ---------------------------------------------------------------------------------------------
# RECOMMENDED
# ---------------------------------------------------------------------------------------------

# Which Core image to run. Pinned to a release; change it deliberately when you upgrade.
ORION_CORE_IMAGE=ghcr.io/sunday-studio/orion-core:0.2.0

# SET THIS. The address people and your servers use to reach Core: http://<server-ip>:8999, or your
# domain such as https://orion.example.com. It appears in the install commands the Console shows, in
# emails and in status page links. Can also be changed later in Console > Settings > General (the saved
# value wins).
ORION_PUBLIC_URL=

# Optional shared secret. When set, a server can only enroll with this value or with a one-time
# token created in Console > Add server. Generate one:  openssl rand -hex 16
# ORION_ENROLLMENT_TOKEN=

# The port Core listens on on this machine (Console, API and public status pages).
# ORION_HTTP_PORT=8999

# ---------------------------------------------------------------------------------------------
# NETWORK AND SECURITY
# ---------------------------------------------------------------------------------------------

# Comma separated IPs or CIDR ranges of reverse proxies in front of Core, so client IPs are read
# from X-Forwarded-For. Leave empty when Core is reached directly.
# ORION_TRUSTED_PROXIES=

# Let alert webhooks and "Test now" monitor checks reach private addresses (10.x, 192.168.x, localhost).
# Off by default to block SSRF. Turn on only if you monitor internal services from Core.
# ORION_ALERT_ALLOW_PRIVATE_WEBHOOKS=false
# ORION_CORE_MONITOR_ALLOW_PRIVATE_TARGETS=false

# Token that protects the Prometheus /metrics endpoint. Empty disables the endpoint.
# ORION_METRICS_TOKEN=

# ---------------------------------------------------------------------------------------------
# ALERT EMAIL (optional; webhook alerts need no setup)
# ---------------------------------------------------------------------------------------------

# ORION_ALERT_SMTP_HOST=smtp.example.com
# ORION_ALERT_SMTP_PORT=587
# ORION_ALERT_SMTP_USERNAME=
# ORION_ALERT_SMTP_PASSWORD=
# ORION_ALERT_SMTP_FROM=alerts@example.com
# One of: starttls (default), tls, none
# ORION_ALERT_SMTP_TLS=starttls
# Needed for email alerts: signs email opt-in and unsubscribe links. Core and the worker both read it
# from this file. Without it email deliveries fail (visibly, in Alerts) while monitoring keeps working.
# Generate one:  openssl rand -hex 32
# ORION_ALERT_EMAIL_SECRET=

# Seconds before the same alert can notify again, and whether recoveries notify.
# ORION_ALERT_COOLDOWN_SECONDS=300
# ORION_ALERT_RECOVERY_NOTIFICATIONS=true

# ---------------------------------------------------------------------------------------------
# PUBLIC STATUS PAGES (optional)
# ---------------------------------------------------------------------------------------------

# Email for status page subscribers (confirmations and incident notices).
# ORION_PUBLIC_STATUS_MAIL_ENABLED=false
# ORION_PUBLIC_STATUS_MAIL_HOST=
# ORION_PUBLIC_STATUS_MAIL_PORT=587
# ORION_PUBLIC_STATUS_MAIL_USERNAME=
# ORION_PUBLIC_STATUS_MAIL_PASSWORD=
# ORION_PUBLIC_STATUS_MAIL_FROM_EMAIL=
# ORION_PUBLIC_STATUS_MAIL_FROM_NAME=Orion Status
# ORION_PUBLIC_STATUS_MAIL_REPLY_TO=
# Origin used in public status links when it differs from ORION_PUBLIC_URL.
# ORION_PUBLIC_STATUS_URL_ORIGIN=
# Signs subscriber links; when set, admins see full subscriber emails. Generate:  openssl rand -hex 32
# ORION_PUBLIC_STATUS_SUBSCRIBER_SECRET=
# DNS target shown for custom status page domains when it differs from the host of ORION_PUBLIC_URL.
# ORION_STATUS_PAGES_CNAME_TARGET=

# ---------------------------------------------------------------------------------------------
# TUNING (defaults are fine for a personal server or a small team)
# ---------------------------------------------------------------------------------------------

# ORION_CORE_MEMORY_LIMIT=512m
# ORION_CORE_CPUS=1.0
# ORION_WORKER_MEMORY_LIMIT=512m
# ORION_WORKER_CPUS=1.0
# ORION_WORKER_CONCURRENCY=16
# How often retention and rollups run, in seconds.
# ORION_DATA_LIFECYCLE_SCHEDULER_SECONDS=3600
# Product logs: queue size and the per-app ingest rate limit (entries per second).
# ORION_LOGS_QUEUE_MAX=50000
# ORION_LOGS_APP_RATE_PER_SECOND=1000
# Console login lifetime in hours.
# ORION_SESSION_HOURS=12
# Brute-force limits: failed logins allowed per window, and node enrollments per minute.
# ORION_LOGIN_RATE_LIMIT_ATTEMPTS=5
# ORION_LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
# ORION_REGISTER_RATE_LIMIT_PER_MINUTE=30
# Core's own log lines (Logs > Internal): days kept and size cap in MB.
# ORION_INTERNAL_LOG_RETENTION_DAYS=7
# ORION_INTERNAL_LOG_MAX_STORAGE_MB=200
# Days before a TLS certificate expires when a monitor starts warning.
# ORION_ALERT_TLS_EXPIRY_DAYS=14
# Developer options; leave as they are. Swagger UI at /swagger and the database log level (warn).
# ORION_ENABLE_SWAGGER=false
# ORION_DB_LOG_LEVEL=warn
# Optional URL that is pinged while Core is healthy, for an external dead man's switch.
# ORION_DEADMAN_URL=
