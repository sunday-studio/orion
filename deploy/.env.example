# Orion Core settings. Copy to .env and fill in the empty values.
# Everything else is optional: see docs/deployment/core-environment.md, or set it in the Console.

ORION_ADMIN_USERNAME=admin
# At least 12 characters. Generate one: openssl rand -base64 24 | tr -d '/+='
ORION_ADMIN_PASSWORD=
# At least 32 characters. Generate one: openssl rand -hex 32
ORION_JWT_SECRET=

# The address people and your servers use to reach Core, for example http://203.0.113.10:8999 or
# https://orion.example.com. Can also be set later in Console > Settings > General.
ORION_PUBLIC_URL=

# Optional shared secret a server needs to enroll. Generate one: openssl rand -hex 16
ORION_ENROLLMENT_TOKEN=

ORION_CORE_IMAGE=ghcr.io/sunday-studio/orion-core:0.2.1
ORION_HTTP_PORT=8999
