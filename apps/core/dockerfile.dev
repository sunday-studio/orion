FROM golang:1.26.11-alpine@sha256:ecb67f987aa1a57794c91d19ade7ae0209f2f0f5496aaef9e6ae85ddf92d02ab

WORKDIR /app

RUN apk add --no-cache build-base ca-certificates sqlite wget

COPY go.mod go.sum ./
RUN go mod download

COPY cmd/ cmd/
COPY docs/ docs/
COPY internal/ internal/
COPY scripts/ scripts/

RUN go build -o /usr/local/bin/orion-core ./cmd/api
RUN go build -o /usr/local/bin/orion-core-worker ./cmd/worker
RUN go build -o /usr/local/bin/orion-seed-demo-data ./scripts/seed-demo-data

RUN mkdir -p /data

ENV ORION_DATA_DIR=/data
ENV ORION_PORT=8999

EXPOSE 8999
VOLUME /data

CMD ["orion-core"]
