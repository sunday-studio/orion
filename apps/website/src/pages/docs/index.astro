---
import { getCollection } from "astro:content";
import Base from "../../layouts/base.astro";
import DocsCards from "../../components/docs/docs-cards.astro";
import "../../styles/docs.css";
const all = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const groups = (["Start", "Guides", "Reference"] as const).map((g) => [g, all.filter((d) => d.data.group === g)] as const);
---
<Base title="Orion documentation" description="Install Orion, connect servers and apps, and keep it running." active="docs" docs ogImage="/og/docs-home" imageAlt="Orion documentation: run Orion yourself">
  <main id="main">
    <div class="dh">
      <span class="k">Documentation</span>
      <h1>Run Orion yourself.</h1>
      <p class="lead">Everything you need to install it, connect your servers and apps, and keep it running.</p>
      <button type="button" class="bigs" data-search-open>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        Search the docs <span class="kb">⌘ K</span>
      </button>
      <div class="chips"><span>Try:</span><a href="/docs/install-core/">docker compose</a><a href="/docs/send-logs/">ingest key</a><a href="/docs/backups/">backup</a><a href="/docs/cli/">orion-agent doctor</a></div>
    </div>
    <DocsCards />
    <div class="tg3">
      {groups.map(([g, items]) => (
        <div class="tp"><div class="gt2 m">{g}</div>
          {items.map((d) => <a class="tl" href={`/docs/${d.id}/`}><b>{d.data.title}</b><span>{d.data.description}</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>)}
        </div>
      ))}
    </div>
    <div class="help"><div><b>Stuck, or found a gap?</b><span>The docs live in the repository. Open an issue or send a fix.</span></div><div class="hb"><a class="b" href="https://github.com/sunday-studio/orion/issues">Open an issue</a><a class="b p" href="https://github.com/sunday-studio/orion/tree/main/apps/website/src/content/docs">Edit on GitHub</a></div></div>
  </main>
</Base>
