---
const cols = [
  ["Product", [["Monitors", "/#product"], ["Incidents", "/#product"], ["Alerts", "/#product"], ["Status pages", "/#product"], ["Logs", "/#product"]]],
  ["Docs", [["Quickstart", "/docs/quickstart/"], ["Install Core", "/docs/install-core/"], ["Install a server", "/docs/install-server/"], ["Send logs", "/docs/send-logs/"]]],
  ["Project", [["GitHub", "https://github.com/sunday-studio/orion"], ["Releases", "https://github.com/sunday-studio/orion/releases"], ["Terminology", "/docs/concepts/"]]],
];
---
<footer class="site-foot">
  <div class="wrap">
    <div class="cols">
      <div><a class="logo" href="/"><span class="mk"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="3"/><circle cx="12" cy="12" r="9" stroke-dasharray="2 4"/></svg></span>Orion</a>
        <p class="muted" style="margin-top:12px;max-width:260px;font-size:14px">Self-hosted monitoring. Your data stays on your hardware.</p></div>
      {cols.map(([h, items]) => <div><h4>{h}</h4><ul>{(items as string[][]).map(([t, href]) => <li><a href={href}>{t}</a></li>)}</ul></div>)}
    </div>
    <div class="fine"><span>Orion by Sunday Studio</span><span>Monitoring for small server setups</span></div>
  </div>
</footer>
