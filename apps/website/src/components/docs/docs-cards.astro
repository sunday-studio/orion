---
import { getCollection } from "astro:content";
const all = (await getCollection("docs")).sort((a, b) => a.data.order - b.data.order);
const by = (id: string) => all.find((d) => d.id === id);
const icons: Record<string, string> = {
  quickstart: '<path d="M5 15c-1.5 1.3-2 5-2 5s3.7-.5 5-2M14 4c3-1 6-1 7-1 0 1 0 4-1 7l-7 7-6-6zM9 9l-4 1-2-2 5-1M15 15l-1 4 2 2 1-5"/>',
  "install-core": '<path d="M21 8l-9-5-9 5v8l9 5 9-5zM3.3 7.5L12 12l8.7-4.5M12 22V12"/>',
  "install-server": '<rect x="3" y="4" width="18" height="7" rx="2"/><rect x="3" y="13" width="18" height="7" rx="2"/><path d="M7 7.5h.01M7 16.5h.01"/>',
  "send-logs": '<path d="M4 6h16M4 12h16M4 18h10"/>',
};
const cards = ["quickstart", "install-core", "install-server", "send-logs"].map((id) => by(id)).filter(Boolean);
---
<div class="qg">
  {cards.map((c) => (
    <a class="qc" href={`/docs/${c!.id}/`}>
      <span class="qi"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[c!.id]} /></span>
      <b>{c!.data.title}</b><span class="qd">{c!.data.description}</span>
      <svg class="qa" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
    </a>
  ))}
</div>
