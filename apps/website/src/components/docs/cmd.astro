---
interface Props { name: string; desc: string; open?: boolean }
const { name, desc, open = false } = Astro.props;
---
<details class="cmd" open={open}>
  <summary><b>{name}</b><span class="d">{desc}</span><svg class="chev" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></summary>
  <div class="bd2"><slot /></div>
</details>
