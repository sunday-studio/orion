---
const tabs = [
  { key: "monitors", label: "Monitors", img: "monitors-list", cap: "HTTP, TCP, heartbeats, server checks", alt: "The Monitors list with status and recent checks" },
  { key: "incidents", label: "Incidents", img: "incident-detail", cap: "Opened, grouped, timed, resolved", alt: "An incident with its timeline and notifications" },
  { key: "alerts", label: "Alerts", img: "alerts-log", cap: "Webhook and email, retried and logged", alt: "The notification log showing sent and failed deliveries" },
  { key: "logs", label: "Logs", img: "logs", cap: "JSON or OpenTelemetry, searchable", alt: "Product logs with filters and a detail drawer" },
  { key: "servers", label: "Server agent", img: "servers-list", cap: "Linux and macOS, containers too", alt: "The Servers list with CPU and memory" },
  { key: "status", label: "Status pages", img: "status-setup", cap: "Optional, on your own domain", alt: "Setting up a public status page" },
] as const;
---
<div class="sec">
  <div class="sechead">
    <span class="k">What is in the box</span>
    <h2 class="h2">Everything you need. Nothing you rent.</h2>
    <p class="lead">Monitoring, incidents, alerts, logs and status pages in one tool, so there is nothing to wire together.</p>
  </div>
  <div class="tour" data-tour>
    <div class="seg" role="group" aria-label="Console screens">
      <span class="thumb" aria-hidden="true"></span>
      {tabs.map((t, i) => (
        <button type="button" class="segi" aria-pressed={i === 0 ? "true" : "false"} data-segment-active={i === 0 ? "" : undefined} data-i={i}>
          <span class="lbl"><span>{t.label}</span></span>
          <span class="lbl on" aria-hidden="true"><span>{t.label}</span></span>
        </button>
      ))}
    </div>
    <div class="frame">
      <div class="fbody">
        {tabs.map((t, i) => (
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset={`/shots/${t.img}-dark.png`} />
            <img class={i === 0 ? "fi is-active" : "fi"} src={`/shots/${t.img}.png`} alt={t.alt} width="1920" height="1500" loading={i === 0 ? "eager" : "lazy"} />
          </picture>
        ))}
      </div>
    </div>
    <div class="capw" aria-live="polite">
      {tabs.map((t, i) => <p class={i === 0 ? "cp is-active" : "cp"}><b>{t.label}.</b> {t.cap}</p>)}
    </div>
  </div>
</div>
