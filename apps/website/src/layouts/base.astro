---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/base-components.css";
import "../styles/responsive.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import SearchDialog from "../components/search-dialog.astro";
interface Props { title: string; description?: string; active?: "docs" | ""; docs?: boolean; footer?: boolean }
const { title, description = "Self-hosted uptime monitoring, incident response and logs for personal projects and small teams, on a machine you own.", active = "", docs = false, footer = true } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111513" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <Header active={active} docs={docs} />
      <slot />
      {footer && <Footer />}
    </div>
    <SearchDialog />
    <script>import "../scripts/site.ts";</script>
  </body>
</html>
