---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/base-components.css";
import "../styles/responsive.css";
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import SearchDialog from "../components/search-dialog.astro";
interface Props { title: string; description?: string; active?: "docs" | ""; docs?: boolean; footer?: boolean; noindex?: boolean; ogImage?: string; imageAlt?: string }
const { ogImage = "/og/home", imageAlt = "Orion: run monitoring and incident response on a machine you own", title, description = "Self-hosted uptime monitoring, incident response and logs for personal projects and small teams, on a machine you own.", active = "", docs = false, footer = true, noindex = false } = Astro.props;
const siteUrl = Astro.site ?? new URL("https://orion.sunday.studio");
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const shareImage = (size: string) => new URL(`${ogImage}-${size}.png`, siteUrl).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111513" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orion" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={shareImage("1200x630")} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image" content={shareImage("1200x1200")} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage("1200x600")} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="icon" href="/favicon.svg" />
    <script is:inline>document.documentElement.classList.add("js");</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="page">
      <Header active={active} docs={docs} />
      <slot />
      {footer && <Footer />}
    </div>
    <SearchDialog />
    <script>import "../scripts/site.ts";</script>
  </body>
</html>
